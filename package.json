{
  "name": "mineai-ide",
  "version": "1.0.0",
  "description": "AI-Powered Minecraft Modding IDE with Electron - Community Edition",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:renderer && electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win --x64",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:all": "npm run build:renderer && electron-builder --win --mac --linux",
    "build:renderer": "vite build --config src/renderer/vite.config.js",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "cross-env NODE_ENV=development electron .",
    "dev:renderer": "vite --config src/renderer/vite.config.js",
    "cli": "node cli/index.js"
  },
  "keywords": [
    "minecraft",
    "modding",
    "ai",
    "electron",
    "blockbench",
    "geckolib",
    "forge",
    "fabric",
    "spigot",
    "community"
  ],
  "author": "MineAI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WayaSteurbautYT/MineAiIde.git"
  },
  "build": {
    "appId": "com.mineai.ide",
    "productName": "MineAI IDE",
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "src/renderer/**/*",
      "public/**/*",
      "cli/**/*",
      "config/**/*",
      "agents/**/*",
      "templates/**/*",
      "!**/*.map"
    ],
    "win": {
        "target": ["nsis", "portable"],
        "icon": "public/icons/icon.svg",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/icons/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "icon": "public/icons",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${name}-${version}-${arch}-setup.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "electronVersion": "31.0.0"
  },
  "dependencies": {
    "@langchain/openai": "^0.2.0",
    "@react-three/drei": "^9.92.0",
    "@react-three/fiber": "^8.15.0",
    "@xenova/transformers": "^2.17.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.6.0",
    "chokidar": "^3.5.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "dexie": "^4.0.0",
    "dotenv": "^16.3.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.0",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "file-saver": "^2.0.5",
    "fluent-ffmpeg": "^2.1.0",
    "fs-extra": "^11.1.0",
    "isomorphic-git": "^1.25.0",
    "jimp": "^0.22.0",
    "jszip": "^3.10.0",
    "langchain": "^0.2.0",
    "lucide-react": "^0.263.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.0",
    "openai": "^4.0.0",
    "pdf-lib": "^1.17.0",
    "pouchdb": "^8.0.0",
    "pouchdb-adapter-idb": "^8.0.0",
    "sharp": "^0.32.0",
    "simple-git": "^3.20.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0",
    "tailwind-merge": "^1.14.0",
    "three": "^0.160.0",
    "uuid": "^9.0.0",
    "ws": "^8.13.0",
    "y-webrtc": "^10.2.5",
    "yjs": "^13.6.0",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}